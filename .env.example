DATABASE_URL=postgresql+asyncpg://your_db_user:your_db_password@localhost:5432/your_db_name
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Script / scene / visual-spec generation: "groq" (cloud, default) or "ollama" (local)
SCRIPT_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
# Only needed if SCRIPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

NARRATION_WPM=130
TTS_VOICE=en-US-ChristopherNeural

PEXELS_API_KEY=your_pexels_api_key_here
FREESOUND_API_KEY=your_freesound_api_key_here
MEDIA_STORAGE_PATH=./media

# "block" = stop for manual approval when footage can't be verified; "best_effort" = use best unverified clip
UNCERTAIN_FOOTAGE_POLICY=block
